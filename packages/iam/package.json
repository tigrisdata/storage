{
  "name": "@tigrisdata/iam",
  "version": "2.9.0",
  "description": "Tigris SDK for IAM operations",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "dev": "tsc --noEmit && tsup --watch",
    "publint": "publint",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "iam",
    "organization",
    "tigris",
    "storage"
  ],
  "author": "Tigris Data",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tigrisdata/storage.git",
    "directory": "packages/iam"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/xml-builder": "^3.972.43",
    "@smithy/signature-v4": "^5.3.14",
    "dotenv": "^18.0.0"
  }
}
